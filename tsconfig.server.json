{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist-server",
    "rootDir": ".",
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "server/**/*.ts",
    "src/lan/protocol.ts",
    "src/lan/discovery.ts",
    "src/lan/lanLobby.ts",
    "src/lan/lanAddress.ts",
    "src/lan/hostToken.ts",
    "src/version.ts"
  ],
  "exclude": ["server/**/*.test.ts"]
}
